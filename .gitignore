# =====================================================
# VIDYALINK — .gitignore
# =====================================================

# ---------------- Dependencies ----------------
node_modules/
.pnp
.pnp.js

# ---------------- Build Outputs ----------------
dist/
build/
out/
.next/
.nuxt/
.output/
*.tsbuildinfo

# ---------------- Environment ----------------
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging

# ---------------- Logs ----------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------------- Runtime ----------------
pids/
*.pid
*.seed
*.pid.lock

# ---------------- Coverage & Testing ----------------
coverage/
*.lcov
.nyc_output/
test-results/
playwright-report/
blob-report/

# ---------------- Editor / IDE ----------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# ---------------- OS Files ----------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ---------------- Uploads ----------------
server/uploads/*
!server/uploads/.gitkeep

# ---------------- AI Service ----------------
ai-service/__pycache__/
ai-service/**/__pycache__/
ai-service/.venv/
ai-service/venv/
ai-service/*.pyc
ai-service/**/*.pyc
ai-service/models/*.bin
ai-service/models/*.pt
ai-service/models/*.onnx

# ---------------- Misc ----------------
*.tgz
.cache/
.parcel-cache/
.turbo/
