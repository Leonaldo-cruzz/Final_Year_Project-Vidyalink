# =====================================================
# VIDYALINK — Environment Variables
# =====================================================
# Copy this file to .env and fill in the values.
# DO NOT commit .env to version control.
# =====================================================

# ---------------- General ----------------
NODE_ENV=development
APP_NAME=VidyaLink

# ---------------- Server ----------------
PORT=5000
HOST=localhost
API_PREFIX=/api/v1

# ---------------- Database ----------------
MONGODB_URI=your_mongodb_uri_here
MONGODB_URI_TEST=your_mongodb_test_uri_here

# ---------------- Authentication ----------------
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=vidyalink-api
JWT_AUDIENCE=vidyalink-client
BCRYPT_SALT_ROUNDS=12

# ---------------- Client ----------------
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.example.com
TRUST_PROXY=false

# ---------------- Email (SMTP) ----------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
EMAIL_FROM=noreply@vidyalink.com

# ---------------- Cloud Storage ----------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---------------- AI Service ----------------
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=your_ai_service_key
RECOMMENDATION_CACHE_TTL_MS=86400000

# ---------------- Rate Limiting ----------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ---------------- Logging ----------------
LOG_LEVEL=debug
