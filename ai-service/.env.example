AI_PROVIDER=deterministic
GEMINI_API_KEY=
OPENAI_API_KEY=
ALLOWED_ORIGINS=http://localhost:5173
HOST=0.0.0.0
PORT=8000
# Shared secret for Node → FastAPI authentication.
# Leave empty for local development (auth is disabled when unset).
# In production both services MUST share the same high-entropy value.
# Generate: node -e "require('crypto').randomBytes(32).toString('hex')"
AI_SERVICE_API_KEY=
# Set to "production" in Render to enforce the key requirement at startup.
AI_ENV=
