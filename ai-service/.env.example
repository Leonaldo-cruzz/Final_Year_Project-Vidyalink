# ============================================================
# VIDYALINK AI Service — Environment Variables Configuration
# ============================================================

# Service Server Configuration
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_SERVICE_ENV=development

# Backend Express API Service URL
BACKEND_BASE_URL=http://localhost:5000/api/v1

# AI Model Provider API Keys (Optional / Placeholders for future phases)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Security & CORS Settings
CORS_ORIGINS=http://localhost:5173,http://localhost:5000
REQUEST_TIMEOUT_SECONDS=15
