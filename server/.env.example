# VIDYALINK server environment
# Copy to server/.env for local server-only configuration. Do not commit it.

# Required at startup
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/vidyalink
JWT_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Application and browser integration
API_PREFIX=/api/v1
API_BASE_URL=http://localhost:5000/api/v1
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
JWT_ISSUER=vidyalink-api
JWT_AUDIENCE=vidyalink-client
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.example.com
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Optional GitHub integration. Public-profile sync works without these.
# GITHUB_TOKEN=replace_with_a_github_token_if_private_endpoints_are_added
# GITHUB_CLIENT_ID=replace_with_a_github_oauth_client_id
# GITHUB_CLIENT_SECRET=replace_with_a_github_oauth_client_secret
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_REQUEST_TIMEOUT_MS=8000

# Optional AI integration. Provider keys stay on the server and are unused until
# an AI client is implemented.
# AI_SERVICE_URL=http://localhost:8000
# AI_SERVICE_API_KEY=replace_with_an_internal_service_key
# GEMINI_API_KEY=replace_with_a_gemini_api_key
# OPENAI_API_KEY=replace_with_an_openai_api_key

# Optional Cloudinary storage. API secret is server-only.
# CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
# CLOUDINARY_API_KEY=replace_with_cloudinary_api_key
# CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret

# Optional email delivery. Password is server-only.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USER=replace_with_smtp_username
# EMAIL_PASSWORD=replace_with_smtp_password
# EMAIL_FROM=noreply@example.com

# Optional seed data. Required only when running server/src/scripts/seed.js.
# DEMO_USER_PASSWORD=replace_with_a_unique_non-production_demo_password
