{
  "name": "vidyalink",
  "version": "0.1.0",
  "private": true,
  "description": "VIDYALINK — AI-Powered Student Portfolio Verification and Recruitment Platform",
  "keywords": [
    "vidyalink",
    "portfolio-verification",
    "recruitment",
    "ai-evaluation",
    "ats-resume",
    "monorepo"
  ],
  "author": "VidyaLink Team",
  "license": "UNLICENSED",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,green \"npm run dev:client\" \"npm run dev:server\"",
    "dev:ai": "powershell -Command \"cd ai-service; .\\venv\\Scripts\\python -m uvicorn src.main:app --port 8000 --reload\"",
    "dev:all": "concurrently -n client,server,ai -c cyan,green,magenta \"npm run dev:client\" \"npm run dev:server\" \"npm run dev:ai\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client",
    "test": "npm run test --workspace=client",
    "test:client": "npm run test --workspace=client",
    "test:server": "npm run test --workspace=server",
    "test:ai": "powershell -Command \"cd ai-service; .\\venv\\Scripts\\python -m pytest\"",
    "test:all": "npm run test:client && npm run test:server && npm run test:ai",
    "seed": "npm run seed --workspace=server",
    "seed:rich": "npm run seed:rich --workspace=server",
    "create:admin": "npm run create:admin --workspace=server",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "clean": "rimraf client/dist server/dist node_modules/.cache"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
